PORT=4000

# Matches the credentials in docker-compose.yml -- don't change one without the other.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_assistant"

# Groq hosts Whisper for free (no billing required). Get a key at console.groq.com/keys
GROQ_API_KEY=

# Used to sign login sessions. Generate your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=